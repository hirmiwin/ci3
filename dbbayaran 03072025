	('315102164', '315102', '2016/2017', '4', 'Mandarin', 'B-', 'Zahra is a polite and friendly student. She enjoys all aspects of work and very independent in finishing directed tasks. She always tries her best to participate in class discussion although sometimes she feels unconfident. Build your speaking skill in the next grade, Zahra !', '2017-06-15', NULL),
	('315102171', '315102', '2017/2018', '1', 'Mandarin', 'B', 'Zahra is smart and quite student. She knows basic Math fact, however she needs to be careful on doing exercise even tests. Overall, she hs good abilities. Keep it up, Zafran!', '2017-10-13', NULL),
